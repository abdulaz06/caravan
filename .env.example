# Copy to .env.local and fill in. Never commit .env.local.
# Step-by-step instructions for every value: see SETUP.md.
# Caravan uses its OWN Supabase project — never the Lanks one (the app refuses to start if you try).

# Supabase → your project → Connect (top bar) → "Project URL", e.g. https://abcdefghijklmnopqrst.supabase.co
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys → the sb_secret_… key.
# Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string, freshly generated for Caravan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Break-glass owner password for any trip's console (/t/<slug>/admin)
ADMIN_PASSWORD=

# Public site URL (Open Graph link previews). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: 1 = always use the local JSON test database (.data/dev-db.json), even if Supabase is set.
# CARAVAN_LOCAL_STORE=1

# Vercel Cron sends this as a Bearer token to /api/cron/reset-demo (nightly demo reset); the
# "Warm the demos" GitHub Action sends it to /api/cron/warm-demos after each deploy (set it as a GitHub secret too).
# Generate a long random string; without it the reset endpoint refuses every call.
CRON_SECRET=
