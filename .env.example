# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for /admin
ADMIN_PASSWORD=

# Public site URL (used for Open Graph link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
