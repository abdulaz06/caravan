# Copy to .env.local and fill in. Never commit .env.local.
# Step-by-step instructions for every value: see SETUP.md.

# Supabase → your project → Connect (top bar) → "Project URL", e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys → the sb_secret_… key
# (the legacy service_role key also works, but Supabase retires legacy keys at the end of 2026).
# Server-only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for /admin
ADMIN_PASSWORD=

# Public site URL (used for Open Graph link previews). On Vercel this falls back
# to the production domain automatically, so it's optional there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
